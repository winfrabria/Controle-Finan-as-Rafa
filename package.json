{
  "name": "winfra-rafael",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-pdf-viewer.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/assert-local-build-stopped.mjs && node scripts/stamp-pwa-worker.mjs && node scripts/prepare-pdf-viewer.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-pdf-worker-build.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test:works": "tsx --conditions=react-server --test src/lib/works/admin-work-contract.test.ts src/lib/works/admin-work-import.test.ts src/lib/works/responsible-name.test.ts src/server/works/admin-work-access.test.ts src/server/works/admin-work-service.integration.test.ts",
    "test:auth": "tsx --test tests/auth/access-policy.test.mjs",
    "test:pwa": "tsx --test tests/pwa/*.test.ts",
    "test:public-flow": "tsx --test src/features/public-upload/submission-history.test.ts src/features/public-upload/public-upload-status.test.ts",
    "test:push": "tsx --conditions=react-server --test src/server/http/same-origin.test.ts src/server/push/*.test.ts tests/pwa/*.test.ts",
    "test:note-detail": "tsx --test src/features/note-detail/*.test.ts src/features/note-detail/data/*.test.ts",
    "test:harness": "tsx --conditions=react-server --test --test-concurrency=1 src/lib/audit-harness/*.test.ts src/lib/audit-harness/evals/*.test.ts tests/harness/*.test.ts tests/harness/*.test.cjs src/features/internal-notes/reviewer-payload-policy.test.ts src/server/integrations/openrouter/*.test.ts src/server/notes/attachment-metadata.test.ts src/server/notes/audit-feedback.test.ts src/server/notes/context-questions.test.ts src/server/notes/note-read-invalidation.test.ts src/server/notes/public-capability.test.ts src/server/notes/public-status.test.ts src/server/notes/public-upload-rate-limit.test.ts src/server/notes/public-upload-rate-limit.integration.test.ts src/server/notes/processing-worker-auth.test.ts src/server/notes/processing-worker.test.ts src/server/notes/processing-concurrency.adversarial.test.ts src/server/notes/processing-jobs.test.ts src/server/notes/processing-jobs.integration.test.ts src/server/notes/record-reviewer-validation.integration.test.ts",
    "test:upload": "tsx --conditions=react-server --test src/features/internal-notes/attachment-reference.test.ts src/features/internal-notes/finding-display.test.ts src/features/internal-notes/note-list-query.test.ts src/features/internal-notes/notification-path.test.ts src/features/internal-notes/reviewer-dashboard-query.test.ts src/features/public-upload/projects-api.test.ts src/features/public-upload/public-upload-status.test.ts src/features/workspace-ui/audit-result-label.test.ts src/features/workspace-ui/dashboard-money.test.ts src/features/workspace-ui/note-visual-data.test.ts src/features/workspace-ui/reviewer-note-filters.test.ts",
    "test:harness-evals": "tsx --conditions=react-server --test src/lib/audit-harness/evals/*.test.ts",
    "evals:harness": "tsx scripts/run-harness-evals.ts",
    "evals:harness:plan": "tsx --conditions=react-server scripts/benchmark-harness-models.ts --plan",
    "evals:harness:online": "tsx --conditions=react-server scripts/benchmark-harness-models.ts --online",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate --no-hints && node scripts/normalize-prisma-output.mjs",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:seed:works": "node prisma/seed-works.mjs",
    "db:seed:demo": "node prisma/seed-demo.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.9",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "chart.js": "^4.5.1",
    "dotenv": "^17.4.2",
    "eventsource-parser": "3.1.1",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
