    "test:works": "tsx --conditions=react-server --test src/lib/works/admin-work-contract.test.ts src/lib/works/admin-work-import.test.ts src/lib/works/responsible-name.test.ts src/server/works/admin-work-access.test.ts src/server/works/admin-work-service.integration.test.ts",
    "test:auth": "tsx --test tests/auth/access-policy.test.mjs",
    "test:pwa": "tsx --test tests/pwa/*.test.ts",
    "test:harness": "tsx --conditions=react-server --test src/lib/audit-harness/*.test.ts src/features/internal-notes/reviewer-payload-policy.test.ts src/server/integrations/openrouter/audit-client.test.ts src/server/integrations/openrouter/client.test.ts src/server/notes/context-questions.test.ts src/server/notes/note-read-invalidation.test.ts src/server/notes/public-capability.test.ts src/server/notes/public-status.test.ts src/server/notes/processing-worker-auth.test.ts src/server/notes/processing-worker.test.ts src/server/notes/processing-jobs.test.ts src/server/notes/processing-jobs.integration.test.ts src/server/notes/record-reviewer-validation.integration.test.ts",
    "test:upload": "tsx --conditions=react-server --test src/features/internal-notes/attachment-reference.test.ts src/features/internal-notes/finding-display.test.ts src/features/internal-notes/note-list-query.test.ts src/features/internal-notes/notification-path.test.ts src/features/internal-notes/reviewer-dashboard-query.test.ts src/features/public-upload/public-upload-status.test.ts src/features/workspace-ui/audit-result-label.test.ts src/features/workspace-ui/dashboard-money.test.ts src/features/workspace-ui/note-visual-data.test.ts src/features/workspace-ui/reviewer-note-filters.test.ts",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:seed:works": "node prisma/seed-works.mjs",
    "db:seed:demo": "node prisma/seed-demo.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "chart.js": "^4.5.1",
    "dotenv": "^17.4.2",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
