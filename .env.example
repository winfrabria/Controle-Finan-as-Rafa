# Aplicacao
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: Postgres, Auth e Storage
NEXT_PUBLIC_SUPABASE_URL=https://project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=notas-fiscais

# Prisma + Supabase Postgres
# Runtime da aplicacao: use o Transaction pooler (porta 6543) em ambientes serverless.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Prisma CLI/migrations: use a conexao direta (porta 5432). Pode exigir IPv6.
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# OpenRouter
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=replace-with-model-id
