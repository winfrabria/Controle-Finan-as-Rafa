# Aplicacao
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: Postgres, Auth e Storage
NEXT_PUBLIC_SUPABASE_URL=https://uvxpmcwwflvrathttxcy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=notas-fiscais
SUPABASE_STORAGE_MAX_FILE_SIZE_BYTES=10485760
SUPABASE_STORAGE_SIGNED_URL_TTL_SECONDS=300

# Prisma + Supabase Postgres
# Runtime da aplicacao: Transaction pooler IPv4 do projeto (porta 6543).
DATABASE_URL="postgresql://postgres.uvxpmcwwflvrathttxcy:YOUR_PASSWORD@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma CLI/migrations: Session pooler IPv4 do projeto (porta 5432).
DIRECT_URL="postgresql://postgres.uvxpmcwwflvrathttxcy:YOUR_PASSWORD@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# OpenRouter
OPENROUTER_API_KEY=replace-with-openrouter-key
# O modo adaptive separa leitura rápida, revisão visual seletiva e auditoria.
# legacy preserva Terra + Sol para rollback imediato.
OPENROUTER_EXTRACTION_PIPELINE=adaptive
OPENROUTER_EXTRACTION_QUALITY_GATE=true
# Extração rápida do documento (primeira etapa)
OPENROUTER_EXTRACTION_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_EXTRACTION_FALLBACK_MODEL=google/gemini-3.7-flash
OPENROUTER_EXTRACTION_REASONING_EFFORT=low
OPENROUTER_EXTRACTION_FALLBACK_REASONING_EFFORT=high
OPENROUTER_EXTRACTION_MAX_TOKENS=16384
# PDF nativo no caminho rápido; OCR pago entra somente na recuperação seletiva.
OPENROUTER_PDF_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_PDF_FALLBACK_MODEL=google/gemini-3.7-flash
OPENROUTER_PDF_REASONING_EFFORT=low
# Auditoria completa (segunda etapa). Use estas variáveis para ciclos
# controlados de comparação; OPENROUTER_MODEL é legado e não altera o Harness.
OPENROUTER_AUDIT_MODEL=openai/gpt-5.6-terra
OPENROUTER_AUDIT_REASONING_EFFORT=high
OPENROUTER_AUDIT_MAX_TOKENS=8192
# Verificador independente seletivo. O modo seguro padrão é off; shadow mede
# sem alterar diagnósticos e enforce só deve ser promovido após o gate humano.
HARNESS_VERIFIER_MODE=off
HARNESS_VERIFIER_GATE_APPROVED=false
OPENROUTER_VERIFIER_MODEL=openai/gpt-5.6-sol
OPENROUTER_VERIFIER_REASONING_EFFORT=high
OPENROUTER_VERIFIER_MAX_TOKENS=16384
HARNESS_WORK_RULES_ENABLED=false
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_EXTRACTION_TIMEOUT_MS=60000
OPENROUTER_MAX_ATTEMPTS=2
OPENROUTER_PDF_ENGINE=native
OPENROUTER_PDF_FALLBACK_ENGINE=native
# Pesquisa seletiva na auditoria profunda. Mantida desligada por padrão porque
# cada busca acrescenta custo além dos tokens do modelo.
OPENROUTER_WEB_SEARCH_ENABLED=false
OPENROUTER_WEB_SEARCH_MAX_RESULTS=3

# Worker durável. Use pelo menos 32 caracteres aleatórios e configure o mesmo
# valor no agendador externo. A Vercel envia CRON_SECRET automaticamente.
CRON_SECRET=replace-with-a-random-worker-secret

# Web Push (VAPID). Gere um único par por ambiente e nunca exponha a chave privada.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
WEB_PUSH_VAPID_SUBJECT=mailto:suporte@winfrabr.com.br
