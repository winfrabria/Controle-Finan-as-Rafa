# Aplicacao
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: Postgres, Auth e Storage
NEXT_PUBLIC_SUPABASE_URL=https://uvxpmcwwflvrathttxcy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=notas-fiscais
SUPABASE_STORAGE_MAX_FILE_SIZE_BYTES=10485760
SUPABASE_STORAGE_SIGNED_URL_TTL_SECONDS=300

# Prisma + Supabase Postgres
# Runtime da aplicacao: Transaction pooler IPv4 do projeto (porta 6543).
DATABASE_URL="postgresql://postgres.uvxpmcwwflvrathttxcy:YOUR_PASSWORD@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma CLI/migrations: Session pooler IPv4 do projeto (porta 5432).
DIRECT_URL="postgresql://postgres.uvxpmcwwflvrathttxcy:YOUR_PASSWORD@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# OpenRouter
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=replace-with-model-id
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_MAX_ATTEMPTS=3
OPENROUTER_PDF_ENGINE=cloudflare-ai
